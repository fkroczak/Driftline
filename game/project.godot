; Engine configuration file.
; Hullbound – Prototyp Phase 2 (ein Run: Sternenkarte und Kämpfe).

config_version=5

[application]

config/name="Hullbound"
config/description="Raumschiff-Roguelike – Prototyp Phase 2"
config/version="0.2"
run/main_scene="res://scenes/map.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[autoload]

Game="*res://scripts/game.gd"

[display]

window/size/viewport_width=384
window/size/viewport_height=216
window/size/window_width_override=1920
window/size/window_height_override=864
window/stretch/mode="viewport"
window/stretch/aspect="expand"
window/stretch/scale_mode="integer"
window/handheld/orientation=4

[input_devices]

pointing/emulate_mouse_from_touch=true

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
textures/vram_compression/import_etc2_astc=true
2d/snap/snap_2d_transforms_to_pixel=true
environment/defaults/default_clear_color=Color(0.027451, 0.0313726, 0.0588235, 1)
